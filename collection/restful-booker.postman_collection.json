    },
    {
      "name": "05 Data-driven",
      "item": [
        {
          "name": "Create booking for guest from CSV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": {{totalprice}},\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-11-02\",\n    \"checkout\": \"2026-11-06\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json().booking;",
                  "pm.test(`Guest ${pm.iterationData.get(\"firstname\")} ${pm.iterationData.get(\"lastname\")} was saved`, () => {",
                  "    pm.expect(b.firstname).to.eql(pm.iterationData.get(\"firstname\"));",
                  "    pm.expect(b.lastname).to.eql(pm.iterationData.get(\"lastname\"));",
                  "    pm.expect(b.totalprice).to.eql(Number(pm.iterationData.get(\"totalprice\")));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ]
}